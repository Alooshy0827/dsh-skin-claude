{
  "name": "dsh-skin-claude",
  "version": "0.2.0",
  "private": true,
  "description": "Claude 风格皮肤 · Anthropic Sans / Serif 字体 · 暖纸色与陶土橙",
  "type": "module",
  "main": "./lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg"
  },
  "files": ["lib", "cordis.patch.yml", "icon.svg", "LICENSE", "README.md", "INSTALL.md"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:local": "node scripts/build-local.mjs",
    "check": "node scripts/build.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "pack:skin": "python3 scripts/pack.py"
  },
  "engines": { "node": ">=20", "dsh": "0.2.1-rc.5" },
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-theme"]
    }
  },
  "repository": { "type": "git", "url": "git+https://github.com/Alooshy0827/dsh-skin-claude.git" },
  "homepage": "https://github.com/Alooshy0827/dsh-skin-claude#readme",
  "license": "MIT"
}
